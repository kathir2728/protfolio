<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Kathir | CSE Portfolio & Resume</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap"
    rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #f0f4f8;
      color: #1e293b;
      line-height: 1.5;
      padding: 2rem 1.5rem;
      transition: background 0.25s ease, color 0.2s ease;
    }

    .resume-card {
      max-width: 1200px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 2rem;
      box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.2);
      overflow: hidden;
      transition: background 0.25s ease, box-shadow 0.2s;
    }

    .resume-grid {
      display: grid;
      grid-template-columns: 34% 66%;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
      background: #0f2b3d;
      color: #e2e8f0;
      padding: 2rem 1.8rem;
      transition: background 0.25s ease;
    }

    .profile h1 {
      font-size: 1.9rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: white;
      margin-bottom: 0.4rem;
    }

    .profile .tagline {
      font-size: 0.95rem;
      background: rgba(255, 255, 255, 0.15);
      display: inline-block;
      padding: 0.25rem 1rem;
      border-radius: 40px;
      font-weight: 500;
      margin: 0.75rem 0 1.2rem 0;
    }

    .contact-info {
      margin: 1.8rem 0 2rem 0;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-size: 0.85rem;
      margin-bottom: 1rem;
      word-break: break-word;
    }

    .contact-item i {
      width: 1.4rem;
      font-size: 1rem;
      color: #7bc5e6;
    }

    .contact-item a {
      color: #e2e8f0;
      text-decoration: none;
      transition: color 0.2s;
    }

    .contact-item a:hover {
      color: white;
      text-decoration: underline;
    }

    .sidebar-section {
      margin: 2rem 0 1.8rem 0;
    }

    .sidebar-section h3 {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-left: 3px solid #5fc1e0;
      padding-left: 0.75rem;
      margin-bottom: 1.2rem;
      color: white;
    }

    .skill-block p {
      font-weight: 500;
      font-size: 0.85rem;
      margin: 0.8rem 0 0.4rem 0;
      color: #cbd5e1;
    }

    .skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .skill-tags span {
      background: rgba(255, 255, 255, 0.12);
      padding: 0.25rem 0.9rem;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 500;
      color: #f1f5f9;
    }

    .lang-hobby-item {
      font-size: 0.9rem;
      margin-bottom: 0.6rem;
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
    }

    .lang-hobby-item i {
      width: 1.3rem;
      font-size: 0.85rem;
      color: #7bc5e6;
    }

    /* ===== MAIN CONTENT ===== */
    .main-content {
      background: white;
      padding: 2rem;
      transition: background 0.2s;
    }

    .section {
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #0f2b3d;
      border-bottom: 3px solid #e2eef5;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .section-title i {
      color: #2c7da0;
      font-size: 1.2rem;
    }

    .summary-text {
      background: #f8fafc;
      padding: 1rem 1.2rem;
      border-radius: 1rem;
      line-height: 1.6;
      font-size: 0.95rem;
      border-left: 4px solid #2c7da0;
    }

    .edu-entry {
      margin-bottom: 1.4rem;
    }

    .edu-title {
      font-weight: 700;
      font-size: 1rem;
      color: #0f2b3d;
    }

    .edu-detail {
      font-size: 0.85rem;
      color: #475569;
      margin-top: 0.2rem;
    }

    .project-card {
      background: #fefefe;
      border-radius: 1rem;
      padding: 1rem 1.2rem;
      margin-bottom: 1.2rem;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
      transition: all 0.2s;
      border: 1px solid #eef2f6;
    }

    .project-card h4 {
      font-size: 1.05rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.6rem;
      color: #1e4a6e;
    }

    .project-card p {
      font-size: 0.9rem;
      color: #334155;
      line-height: 1.5;
    }

    .awards-list {
      list-style: none;
      padding-left: 0;
    }

    .awards-list li {
      margin-bottom: 0.8rem;
      font-size: 0.9rem;
      display: flex;
      gap: 0.7rem;
      align-items: baseline;
    }

    .awards-list li i {
      color: #2c7da0;
      font-size: 0.8rem;
      width: 1.2rem;
      margin-top: 0.2rem;
    }

    .action-buttons {
      display: flex;
      justify-content: flex-end;
      gap: 1rem;
      margin-bottom: 1rem;
      padding: 0 0.5rem;
    }

    .btn {
      background: #eef2ff;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 40px;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      font-family: inherit;
      transition: 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: #1e293b;
    }

    .btn-dark {
      background: #1e293b;
      color: white;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 10px rgba(0, 0, 0, 0.05);
    }

    /* ===== DARK MODE ===== */
    body.dark {
      background: #121826;
    }

    body.dark .resume-card {
      background: #1e293b;
      box-shadow: 0 25px 40px -12px rgba(0, 0, 0, 0.5);
    }

    body.dark .sidebar {
      background: #0a1a24;
    }

    body.dark .main-content {
      background: #1e293b;
    }

    body.dark .main-content .section-title {
      color: #cbd5e6;
      border-bottom-color: #2d3a4b;
    }

    body.dark .section-title i {
      color: #6ab0d6;
    }

    body.dark .summary-text {
      background: #2d3a4b;
      color: #e2e8f0;
      border-left-color: #6ab0d6;
    }

    body.dark .project-card {
      background: #2d3a4b;
      border-color: #40556b;
    }

    body.dark .project-card h4 {
      color: #cbd5e6;
    }

    body.dark .project-card p,
    body.dark .edu-detail,
    body.dark .awards-list li {
      color: #cbd5e6;
    }

    body.dark .edu-title {
      color: #e2e8f0;
    }

    body.dark .btn {
      background: #334155;
      color: #f1f5f9;
    }

    body.dark .btn-dark {
      background: #facc15;
      color: #0f172a;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 780px) {
      body {
        padding: 1rem;
      }

      .resume-grid {
        grid-template-columns: 1fr;
      }

      .sidebar {
        padding: 1.8rem;
      }

      .main-content {
        padding: 1.6rem;
      }

      .action-buttons {
        justify-content: center;
        margin-bottom: 0.5rem;
      }
    }

    /* ===== PRINT ===== */
    @media print {
      body {
        background: white;
        padding: 0;
        margin: 0;
      }

      .action-buttons {
        display: none;
      }

      .resume-card {
        box-shadow: none;
        border-radius: 0;
        max-width: 100%;
      }

      .sidebar,
      .main-content {
        break-inside: avoid;
      }

      .sidebar {
        background: #f1f5f9 !important;
        color: #0f172a !important;
      }

      .main-content {
        background: white !important;
      }

      .skill-tags span {
        background: #e2e8f0 !important;
        color: #1e293b !important;
      }
    }
  </style>
</head>

<body>
